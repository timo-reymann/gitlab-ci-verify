{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>timo-reymann/renovate-config",
    "local>timo-reymann/renovate-config//presets/ecosystems/go",
    "local>timo-reymann/renovate-config//presets/groups/go-git-tooling",
    "local>timo-reymann/renovate-config//presets/groups/go-opa-isolated",
    "local>timo-reymann/renovate-config//presets/groups/go-yaml-fork"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal\\/shellcheck\\/bin\\/VERSION$/"
      ],
      "matchStrings": [
        "^v?(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "koalaman/shellcheck",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "setuptools"
      ],
      "allowedVersions": "<76.0.0"
    }
  ]
}
